@prefix ag:   <https://w3id.org/agrisea/ontology#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix prov: <http://www.w3.org/ns/prov#> .

<https://w3id.org/agrisea/ontology>
    a owl:Ontology ;
    rdfs:label "농해수위 국정감사 온톨로지 (AgriSea Audit Ontology)"@ko ;
    rdfs:comment "국회 농림축산식품해양수산위원회 회의록을 회의·안건·발언·발언자·피감기관·쟁점·이행약속으로 구조화하여 국정감사 준비와 사후관리에 활용하기 위한 온톨로지."@ko ;
    owl:versionInfo "0.2.0" ;
    rdfs:seeAlso <https://w3id.org/agrisea/ontology/rules> .

########## 클래스 ##########

ag:Committee a owl:Class ; rdfs:label "위원회"@ko .

ag:Meeting a owl:Class ; rdfs:label "회의"@ko ;
    rdfs:subClassOf prov:Activity .
ag:AuditMeeting a owl:Class ; rdfs:subClassOf ag:Meeting ; rdfs:label "국정감사 회의"@ko .
ag:PlenaryCommitteeMeeting a owl:Class ; rdfs:subClassOf ag:Meeting ; rdfs:label "전체회의"@ko .
ag:SubcommitteeMeeting a owl:Class ; rdfs:subClassOf ag:Meeting ; rdfs:label "소위원회 회의"@ko .

ag:Session a owl:Class ; rdfs:label "회기"@ko .

ag:AgendaItem a owl:Class ; rdfs:label "안건"@ko .

ag:Utterance a owl:Class ; rdfs:label "발언"@ko .
ag:Question a owl:Class ; rdfs:subClassOf ag:Utterance ; rdfs:label "질의"@ko .
ag:Answer a owl:Class ; rdfs:subClassOf ag:Utterance ; rdfs:label "답변"@ko .
ag:Commitment a owl:Class ; rdfs:subClassOf ag:Answer ;
    rdfs:label "이행약속 답변"@ko ;
    rdfs:comment "'검토하겠습니다', '개선하겠습니다' 등 후속조치를 약속한 답변. 국정감사 결과보고서·시정처리 요구의 추적 대상."@ko .
ag:DataRequest a owl:Class ; rdfs:subClassOf ag:Utterance ; rdfs:label "자료요구"@ko ;
    rdfs:comment "자료를 요구한 발언. 질의 중에 자료를 요구하는 경우가 많아 질의(ag:Question)와 겹칠 수 있다(서로 배타 아님)."@ko .

ag:Person a owl:Class ; rdfs:subClassOf foaf:Person ; rdfs:label "인물"@ko .
ag:Legislator a owl:Class ; rdfs:subClassOf ag:Person ; rdfs:label "국회의원"@ko .
ag:Chair a owl:Class ; rdfs:subClassOf ag:Legislator ; rdfs:label "위원장"@ko .
ag:GovernmentOfficial a owl:Class ; rdfs:subClassOf ag:Person ; rdfs:label "정부·기관 관계자"@ko .
ag:Witness a owl:Class ; rdfs:subClassOf ag:Person ; rdfs:label "증인·참고인"@ko .
ag:Staff a owl:Class ; rdfs:subClassOf ag:Person ; rdfs:label "위원회 직원"@ko .

ag:Organization a owl:Class ; rdfs:subClassOf foaf:Organization ; rdfs:label "기관"@ko .
ag:AuditedAgency a owl:Class ; rdfs:subClassOf ag:Organization ; rdfs:label "피감기관"@ko .

ag:Issue a owl:Class ; rdfs:subClassOf skos:Concept ; rdfs:label "쟁점"@ko .

ag:SupportProgram a owl:Class ; rdfs:label "지원사업 공고"@ko ;
    rdfs:comment "공공데이터포털(창업진흥원 K-Startup)의 농림·해양수산 관련 지원사업 공고. 쟁점·주관 기관·정부 약속과 이어진다."@ko .
ag:IssueScheme a skos:ConceptScheme ; rdfs:label "농해수위 쟁점 분류체계"@ko .

########## 객체 속성 ##########

ag:heldBy a owl:ObjectProperty ; rdfs:label "주관 위원회"@ko ;
    rdfs:domain ag:Meeting ; rdfs:range ag:Committee .
ag:inSession a owl:ObjectProperty ; rdfs:label "회기"@ko ;
    rdfs:domain ag:Meeting ; rdfs:range ag:Session .
ag:hasAgendaItem a owl:ObjectProperty ; rdfs:label "안건"@ko ;
    rdfs:domain ag:Meeting ; rdfs:range ag:AgendaItem .
ag:hasUtterance a owl:ObjectProperty ; rdfs:label "발언 포함"@ko ;
    rdfs:domain ag:Meeting ; rdfs:range ag:Utterance ; owl:inverseOf ag:inMeeting .
ag:inMeeting a owl:ObjectProperty ; rdfs:label "발언 회의"@ko .
ag:onAgendaItem a owl:ObjectProperty ; rdfs:label "관련 안건"@ko ;
    rdfs:domain ag:Utterance ; rdfs:range ag:AgendaItem .
ag:spokenBy a owl:ObjectProperty ; rdfs:label "발언자"@ko ;
    rdfs:domain ag:Utterance ; rdfs:range ag:Person .
ag:respondsTo a owl:ObjectProperty ; rdfs:label "~에 대한 답변"@ko ;
    rdfs:domain ag:Answer ; rdfs:range ag:Question .
ag:addressedTo a owl:ObjectProperty ; rdfs:label "질의 대상 기관"@ko ;
    rdfs:domain ag:Question ; rdfs:range ag:Organization .
ag:mentionsOrganization a owl:ObjectProperty ; rdfs:label "언급 기관"@ko ;
    rdfs:comment "발언이나 안건 문구가 언급한 기관."@ko ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( ag:Utterance ag:AgendaItem ) ] ; rdfs:range ag:Organization .
ag:concernsIssue a owl:ObjectProperty ; rdfs:label "관련 쟁점"@ko ;
    rdfs:comment "발언·회의·지원사업 공고가 다룬 쟁점. 여러 종류의 개체가 쓰므로 정의역을 두지 않는다."@ko ;
    rdfs:range ag:Issue .
ag:affiliatedWith a owl:ObjectProperty ; rdfs:label "소속 기관"@ko ;
    rdfs:domain ag:Person ; rdfs:range ag:Organization .
ag:memberOf a owl:ObjectProperty ; rdfs:label "소속 위원회"@ko ;
    rdfs:domain ag:Legislator ; rdfs:range ag:Committee .
ag:audited a owl:ObjectProperty ; rdfs:label "감사 대상"@ko ;
    rdfs:domain ag:AuditMeeting ; rdfs:range ag:AuditedAgency .
ag:committedBy a owl:ObjectProperty ; rdfs:label "약속 주체 기관"@ko ;
    rdfs:domain ag:Commitment ; rdfs:range ag:Organization .
ag:announcedBy a owl:ObjectProperty ; rdfs:label "공고 기관(피감기관)"@ko ;
    rdfs:domain ag:SupportProgram ; rdfs:range ag:Organization .
########## 데이터 속성 ##########

ag:meetingDate a owl:DatatypeProperty ; rdfs:label "회의일자"@ko ; rdfs:range xsd:date .
ag:assemblyTerm a owl:DatatypeProperty ; rdfs:label "대수"@ko ; rdfs:range xsd:integer .
ag:sessionNumber a owl:DatatypeProperty ; rdfs:label "회기 번호"@ko ; rdfs:range xsd:integer .
ag:meetingNumber a owl:DatatypeProperty ; rdfs:label "차수"@ko ; rdfs:range xsd:integer .
ag:meetingKind a owl:DatatypeProperty ; rdfs:label "회의 종류"@ko .
ag:orderIndex a owl:DatatypeProperty ; rdfs:label "순번"@ko ; rdfs:range xsd:integer .
ag:text a owl:DatatypeProperty ; rdfs:label "발언 내용"@ko .
ag:role a owl:DatatypeProperty ; rdfs:label "직위·역할"@ko .
ag:pdfURL a owl:DatatypeProperty ; rdfs:label "회의록 PDF"@ko ; rdfs:range xsd:anyURI .
ag:minutesURL a owl:DatatypeProperty ; rdfs:label "회의록 보기"@ko ; rdfs:range xsd:anyURI .
ag:vodURL a owl:DatatypeProperty ; rdfs:label "영상회의록"@ko ; rdfs:range xsd:anyURI .
ag:keyword a owl:DatatypeProperty ; rdfs:label "쟁점 키워드"@ko .
ag:receptionStart a owl:DatatypeProperty ; rdfs:label "접수 시작일"@ko ; rdfs:range xsd:date .
ag:receptionEnd a owl:DatatypeProperty ; rdfs:label "접수 마감일"@ko ; rdfs:range xsd:date .
ag:announcementURL a owl:DatatypeProperty ; rdfs:label "공고 보기"@ko ; rdfs:range xsd:anyURI .
ag:announcer a owl:DatatypeProperty ; rdfs:label "공고 기관명"@ko .
ag:isSampleData a owl:DatatypeProperty ; rdfs:label "예시(가상) 데이터 여부"@ko ; rdfs:range xsd:boolean .

########## v0.2: 의안·이행 추적·추론 관계 ##########
# 아래 '추론' 표시 관계는 데이터에 직접 넣지 않고 추론기(agrisea/reasoner.py)가 공리·규칙으로 도출한다.

ag:Bill a owl:Class ; rdfs:label "의안"@ko ;
    rdfs:comment "안건에 오른 법률안 등. 의안번호(ag:billNumber)로 식별한다. 같은 의안이 소위원회와 전체회의에 거듭 올라오면 하나의 개체로 이어진다."@ko .
ag:GovernmentBill a owl:Class ; rdfs:subClassOf ag:Bill ; rdfs:label "정부 제출 의안"@ko .
ag:MemberBill a owl:Class ; rdfs:subClassOf ag:Bill ; rdfs:label "의원 발의 의안"@ko .
ag:CommitteeAlternative a owl:Class ; rdfs:subClassOf ag:Bill ; rdfs:label "위원회 대안"@ko .

ag:FollowUpEvidence a owl:Class ; rdfs:subClassOf prov:Entity ; rdfs:label "이행 근거"@ko ;
    rdfs:comment "약속 뒤 회의록·안건에서 찾은 기록(이행 보고·진행 중·재지적 신호)."@ko .
ag:FollowUpStatus a owl:Class ; rdfs:subClassOf skos:Concept ; rdfs:label "이행 판정"@ko .
ag:ActionType a owl:Class ; rdfs:subClassOf skos:Concept ; rdfs:label "조치 유형"@ko .
ag:FollowUpStatusScheme a skos:ConceptScheme ; rdfs:label "약속 이행 판정 체계"@ko .
ag:ActionTypeScheme a skos:ConceptScheme ; rdfs:label "약속 조치 유형 체계"@ko .

ag:OpenCommitment a owl:Class ; rdfs:subClassOf ag:Commitment ; rdfs:label "국감 확인 대상 약속"@ko ;
    rdfs:comment "이행 판정이 '재지적' 또는 '근거 미확인'인 약속(추론)."@ko ;
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( ag:Commitment
        [ a owl:Restriction ; owl:onProperty ag:followUpStatus ;
          owl:someValuesFrom [ a owl:Class ; owl:oneOf ( <https://w3id.org/agrisea/id/status/reraised> <https://w3id.org/agrisea/id/status/none> ) ] ] ) ] .
ag:FulfilledCommitment a owl:Class ; rdfs:subClassOf ag:Commitment ; rdfs:label "이행 보고된 약속"@ko ;
    owl:equivalentClass [ a owl:Restriction ; owl:onProperty ag:followUpStatus ;
                          owl:hasValue <https://w3id.org/agrisea/id/status/done> ] .

ag:InferenceRule a owl:Class ; rdfs:label "추론 규칙"@ko .

# 의안
ag:aboutBill a owl:ObjectProperty ; rdfs:label "다룬 의안"@ko ;
    rdfs:domain ag:AgendaItem ; rdfs:range ag:Bill .
ag:proposedBy a owl:ObjectProperty ; rdfs:label "대표발의 의원"@ko ;
    rdfs:domain ag:Bill ; rdfs:range ag:Legislator ; owl:inverseOf ag:proposed .
ag:proposed a owl:ObjectProperty ; rdfs:label "대표발의한 의안"@ko .
ag:deliberated a owl:ObjectProperty ; rdfs:label "심사한 의안(추론)"@ko ;
    rdfs:domain ag:Meeting ; rdfs:range ag:Bill ;
    owl:propertyChainAxiom ( ag:hasAgendaItem ag:aboutBill ) ; owl:inverseOf ag:deliberatedIn .
ag:deliberatedIn a owl:ObjectProperty ; rdfs:label "심사한 회의(추론)"@ko .

# 이행 추적
ag:followUpStatus a owl:ObjectProperty, owl:FunctionalProperty ; rdfs:label "이행 판정"@ko ;
    rdfs:comment "약속마다 꼭 하나. 대상이 드러나지 않아 추적하지 않은 약속은 '추적 불가'."@ko ;
    rdfs:domain ag:Commitment ; rdfs:range ag:FollowUpStatus .
ag:actionType a owl:ObjectProperty ; rdfs:label "조치 유형"@ko ;
    rdfs:domain ag:Commitment ; rdfs:range ag:ActionType .
ag:hasEvidence a owl:ObjectProperty ; rdfs:label "이행 근거"@ko ;
    rdfs:domain ag:Commitment ; rdfs:range ag:FollowUpEvidence ; owl:inverseOf ag:evidenceFor .
ag:evidenceFor a owl:ObjectProperty ; rdfs:label "근거 대상 약속"@ko .
ag:evidenceIn a owl:ObjectProperty ; rdfs:label "근거가 나온 회의"@ko ;
    rdfs:domain ag:FollowUpEvidence ; rdfs:range ag:Meeting .
ag:raisedBy a owl:ObjectProperty ; rdfs:label "질의한 의원"@ko ;
    rdfs:comment "약속을 이끌어 낸 의원(약속 바로 앞 질의의 발언자)."@ko ;
    rdfs:domain ag:Commitment ; rdfs:range ag:Legislator .

# 역관계·하위 관계(공리)
ag:spokenBy owl:inverseOf ag:speaks .
ag:speaks a owl:ObjectProperty ; rdfs:label "한 발언"@ko .
ag:respondsTo owl:inverseOf ag:answeredBy .
ag:answeredBy a owl:ObjectProperty ; rdfs:label "받은 답변"@ko .
ag:committedBy owl:inverseOf ag:madeCommitment .
ag:madeCommitment a owl:ObjectProperty ; rdfs:label "한 약속"@ko .
ag:addressedTo rdfs:subPropertyOf ag:mentionsOrganization .
ag:concernsIssue rdfs:subPropertyOf ag:concernsTopic .
ag:concernsTopic a owl:ObjectProperty ; rdfs:label "다룬 주제(상위 쟁점 포함, 추론)"@ko ; rdfs:range ag:Issue .

# 추론 관계(도메인 규칙)
ag:questionedOn a owl:ObjectProperty ; rdfs:label "질의한 쟁점(추론)"@ko ;
    rdfs:domain ag:Legislator ; rdfs:range ag:Issue ; owl:inverseOf ag:questionedBy .
ag:questionedBy a owl:ObjectProperty ; rdfs:label "질의한 의원(추론)"@ko .
ag:questionedAgency a owl:ObjectProperty ; rdfs:label "질의한 기관(추론)"@ko ;
    rdfs:domain ag:Legislator ; rdfs:range ag:Organization ; owl:inverseOf ag:questionedByMember .
ag:questionedByMember a owl:ObjectProperty ; rdfs:label "질의한 의원(추론)"@ko .
ag:respondedOn a owl:ObjectProperty ; rdfs:label "답변한 쟁점(추론)"@ko ;
    rdfs:domain ag:Organization ; rdfs:range ag:Issue ; owl:inverseOf ag:respondedBy .
ag:respondedBy a owl:ObjectProperty ; rdfs:label "답변한 기관(추론)"@ko .
ag:pledgedOn a owl:ObjectProperty ; rdfs:label "약속한 쟁점(추론)"@ko ;
    rdfs:domain ag:Organization ; rdfs:range ag:Issue ; owl:inverseOf ag:pledgedBy .
ag:pledgedBy a owl:ObjectProperty ; rdfs:label "약속한 기관(추론)"@ko .
ag:relatedIssue a owl:ObjectProperty, owl:SymmetricProperty ; rdfs:label "함께 논의된 쟁점(추론)"@ko ;
    rdfs:domain ag:Issue ; rdfs:range ag:Issue .
ag:hasSupportProgram a owl:ObjectProperty ; rdfs:label "관련 지원사업(추론)"@ko ;
    rdfs:domain ag:Issue ; rdfs:range ag:SupportProgram .

ag:billNumber a owl:DatatypeProperty ; rdfs:label "의안번호"@ko ; rdfs:subPropertyOf dct:identifier .
ag:evidenceDate a owl:DatatypeProperty ; rdfs:label "근거 일자"@ko ; rdfs:range xsd:date .
ag:evidenceKind a owl:DatatypeProperty ; rdfs:label "근거 종류"@ko .
ag:evidenceSource a owl:DatatypeProperty ; rdfs:label "근거 출처"@ko .
ag:ruleKind a owl:DatatypeProperty ; rdfs:label "규칙 종류"@ko .
ag:ruleQuery a owl:DatatypeProperty ; rdfs:label "규칙(SPARQL)"@ko .
ag:inferredCount a owl:DatatypeProperty ; rdfs:label "추론한 사실 수"@ko ; rdfs:range xsd:integer .

########## 서로 배타인 클래스(검증: agrisea/validate.py) ##########
# 한 개체가 두 클래스에 함께 속하면 모순이다. 역할(정부 관계자·증인)은 같은 사람이 겸할 수 있어 배타로 두지 않는다.

[] a owl:AllDisjointClasses ;
    owl:members ( ag:Meeting ag:AgendaItem ag:Utterance ag:Person ag:Organization ag:Bill ag:Issue ag:SupportProgram ag:FollowUpEvidence ag:Session ag:Committee ) .
[] a owl:AllDisjointClasses ; owl:members ( ag:AuditMeeting ag:PlenaryCommitteeMeeting ag:SubcommitteeMeeting ) .
[] a owl:AllDisjointClasses ; owl:members ( ag:GovernmentBill ag:MemberBill ag:CommitteeAlternative ) .
ag:Question owl:disjointWith ag:Answer .
ag:Legislator owl:disjointWith ag:GovernmentOfficial , ag:Staff .
ag:OpenCommitment owl:disjointWith ag:FulfilledCommitment .
ag:FollowUpStatus owl:disjointWith ag:ActionType , ag:Issue .
