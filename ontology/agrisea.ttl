@prefix ag:   <https://w3id.org/agrisea/ontology#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix prov: <http://www.w3.org/ns/prov#> .

<https://w3id.org/agrisea/ontology>
    a owl:Ontology ;
    rdfs:label "농해수위 국정감사 온톨로지 (AgriSea Audit Ontology)"@ko ;
    rdfs:comment "국회 농림축산식품해양수산위원회 회의록을 회의·안건·발언·발언자·피감기관·쟁점·이행약속으로 구조화하여 국정감사 준비와 사후관리에 활용하기 위한 온톨로지."@ko ;
    owl:versionInfo "0.1.0" .

########## 클래스 ##########

ag:Committee a owl:Class ; rdfs:label "위원회"@ko .

ag:Meeting a owl:Class ; rdfs:label "회의"@ko ;
    rdfs:subClassOf prov:Activity .
ag:AuditMeeting a owl:Class ; rdfs:subClassOf ag:Meeting ; rdfs:label "국정감사 회의"@ko .
ag:PlenaryCommitteeMeeting a owl:Class ; rdfs:subClassOf ag:Meeting ; rdfs:label "전체회의"@ko .
ag:SubcommitteeMeeting a owl:Class ; rdfs:subClassOf ag:Meeting ; rdfs:label "소위원회 회의"@ko .

ag:Session a owl:Class ; rdfs:label "회기"@ko .

ag:AgendaItem a owl:Class ; rdfs:label "안건"@ko .

ag:MinutesDocument a owl:Class ; rdfs:label "회의록 문서"@ko ;
    rdfs:subClassOf foaf:Document .

ag:Utterance a owl:Class ; rdfs:label "발언"@ko .
ag:Question a owl:Class ; rdfs:subClassOf ag:Utterance ; rdfs:label "질의"@ko .
ag:Answer a owl:Class ; rdfs:subClassOf ag:Utterance ; rdfs:label "답변"@ko .
ag:Commitment a owl:Class ; rdfs:subClassOf ag:Answer ;
    rdfs:label "이행약속 답변"@ko ;
    rdfs:comment "'검토하겠습니다', '개선하겠습니다' 등 후속조치를 약속한 답변. 국정감사 결과보고서·시정처리 요구의 추적 대상."@ko .
ag:DataRequest a owl:Class ; rdfs:subClassOf ag:Utterance ; rdfs:label "자료요구"@ko .

ag:Person a owl:Class ; rdfs:subClassOf foaf:Person ; rdfs:label "인물"@ko .
ag:Legislator a owl:Class ; rdfs:subClassOf ag:Person ; rdfs:label "국회의원(위원)"@ko .
ag:Chair a owl:Class ; rdfs:subClassOf ag:Legislator ; rdfs:label "위원장"@ko .
ag:GovernmentOfficial a owl:Class ; rdfs:subClassOf ag:Person ; rdfs:label "정부·기관 관계자"@ko .
ag:Witness a owl:Class ; rdfs:subClassOf ag:Person ; rdfs:label "증인·참고인"@ko .
ag:Staff a owl:Class ; rdfs:subClassOf ag:Person ; rdfs:label "위원회 직원"@ko .

ag:Organization a owl:Class ; rdfs:subClassOf foaf:Organization ; rdfs:label "기관"@ko .
ag:AuditedAgency a owl:Class ; rdfs:subClassOf ag:Organization ; rdfs:label "피감기관"@ko .

ag:Issue a owl:Class ; rdfs:subClassOf skos:Concept ; rdfs:label "쟁점"@ko .

ag:SupportProgram a owl:Class ; rdfs:label "지원사업 공고"@ko ;
    rdfs:comment "공공데이터포털(창업진흥원 K-Startup)의 농림·해양수산 관련 지원사업 공고. 쟁점·주관 기관·정부 약속과 이어진다."@ko .
ag:IssueScheme a skos:ConceptScheme ; rdfs:label "농해수위 쟁점 분류체계"@ko .

########## 객체 속성 ##########

ag:heldBy a owl:ObjectProperty ; rdfs:label "주관 위원회"@ko ;
    rdfs:domain ag:Meeting ; rdfs:range ag:Committee .
ag:inSession a owl:ObjectProperty ; rdfs:label "회기"@ko ;
    rdfs:domain ag:Meeting ; rdfs:range ag:Session .
ag:hasAgendaItem a owl:ObjectProperty ; rdfs:label "안건"@ko ;
    rdfs:domain ag:Meeting ; rdfs:range ag:AgendaItem .
ag:hasMinutes a owl:ObjectProperty ; rdfs:label "회의록"@ko ;
    rdfs:domain ag:Meeting ; rdfs:range ag:MinutesDocument .
ag:hasUtterance a owl:ObjectProperty ; rdfs:label "발언 포함"@ko ;
    rdfs:domain ag:Meeting ; rdfs:range ag:Utterance ; owl:inverseOf ag:inMeeting .
ag:inMeeting a owl:ObjectProperty ; rdfs:label "발언 회의"@ko .
ag:onAgendaItem a owl:ObjectProperty ; rdfs:label "관련 안건"@ko ;
    rdfs:domain ag:Utterance ; rdfs:range ag:AgendaItem .
ag:spokenBy a owl:ObjectProperty ; rdfs:label "발언자"@ko ;
    rdfs:domain ag:Utterance ; rdfs:range ag:Person .
ag:respondsTo a owl:ObjectProperty ; rdfs:label "~에 대한 답변"@ko ;
    rdfs:domain ag:Answer ; rdfs:range ag:Question .
ag:addressedTo a owl:ObjectProperty ; rdfs:label "질의 대상 기관"@ko ;
    rdfs:domain ag:Question ; rdfs:range ag:Organization .
ag:mentionsOrganization a owl:ObjectProperty ; rdfs:label "언급 기관"@ko ;
    rdfs:domain ag:Utterance ; rdfs:range ag:Organization .
ag:concernsIssue a owl:ObjectProperty ; rdfs:label "관련 쟁점"@ko ;
    rdfs:range ag:Issue .
ag:affiliatedWith a owl:ObjectProperty ; rdfs:label "소속 기관"@ko ;
    rdfs:domain ag:Person ; rdfs:range ag:Organization .
ag:memberOf a owl:ObjectProperty ; rdfs:label "소속 위원회"@ko ;
    rdfs:domain ag:Legislator ; rdfs:range ag:Committee .
ag:audited a owl:ObjectProperty ; rdfs:label "감사 대상"@ko ;
    rdfs:domain ag:AuditMeeting ; rdfs:range ag:AuditedAgency .
ag:committedBy a owl:ObjectProperty ; rdfs:label "약속 주체 기관"@ko ;
    rdfs:domain ag:Commitment ; rdfs:range ag:Organization .
ag:announcedBy a owl:ObjectProperty ; rdfs:label "공고 기관(피감기관)"@ko ;
    rdfs:domain ag:SupportProgram ; rdfs:range ag:Organization .
ag:followedUpBy a owl:ObjectProperty ; rdfs:label "약속 뒤 공고"@ko ;
    rdfs:comment "정부 약속 뒤에 같은 쟁점·대상어로 나온 지원사업 공고(이행 추적 근거)."@ko ;
    rdfs:domain ag:Commitment ; rdfs:range ag:SupportProgram .

########## 데이터 속성 ##########

ag:meetingDate a owl:DatatypeProperty ; rdfs:label "회의일자"@ko ; rdfs:range xsd:date .
ag:assemblyTerm a owl:DatatypeProperty ; rdfs:label "대수"@ko ; rdfs:range xsd:integer .
ag:sessionNumber a owl:DatatypeProperty ; rdfs:label "회기 번호"@ko ; rdfs:range xsd:integer .
ag:meetingNumber a owl:DatatypeProperty ; rdfs:label "차수"@ko ; rdfs:range xsd:integer .
ag:meetingKind a owl:DatatypeProperty ; rdfs:label "회의 종류"@ko .
ag:orderIndex a owl:DatatypeProperty ; rdfs:label "순번"@ko ; rdfs:range xsd:integer .
ag:text a owl:DatatypeProperty ; rdfs:label "발언 내용"@ko .
ag:role a owl:DatatypeProperty ; rdfs:label "직위·역할"@ko .
ag:pdfURL a owl:DatatypeProperty ; rdfs:label "회의록 PDF"@ko ; rdfs:range xsd:anyURI .
ag:minutesURL a owl:DatatypeProperty ; rdfs:label "회의록 보기"@ko ; rdfs:range xsd:anyURI .
ag:vodURL a owl:DatatypeProperty ; rdfs:label "영상회의록"@ko ; rdfs:range xsd:anyURI .
ag:keyword a owl:DatatypeProperty ; rdfs:label "쟁점 키워드"@ko .
ag:mentionCount a owl:DatatypeProperty ; rdfs:label "언급 횟수"@ko ; rdfs:range xsd:integer .
ag:receptionStart a owl:DatatypeProperty ; rdfs:label "접수 시작일"@ko ; rdfs:range xsd:date .
ag:receptionEnd a owl:DatatypeProperty ; rdfs:label "접수 마감일"@ko ; rdfs:range xsd:date .
ag:announcementURL a owl:DatatypeProperty ; rdfs:label "공고 보기"@ko ; rdfs:range xsd:anyURI .
ag:announcer a owl:DatatypeProperty ; rdfs:label "공고 기관명"@ko .
ag:isSampleData a owl:DatatypeProperty ; rdfs:label "예시(가상) 데이터 여부"@ko ; rdfs:range xsd:boolean .
